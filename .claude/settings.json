{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/check-after-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/require-infra-approval.sh"
          },
          {
            "type": "command",
            "command": "./scripts/require-merge-approval.sh"
          },
          {
            "type": "command",
            "command": "./scripts/require-push-approval.sh"
          },
          {
            "type": "command",
            "command": "./scripts/require-release-density.sh"
          },
          {
            "type": "command",
            "command": "./scripts/require-review.sh"
          }
        ]
      }
    ]
  }
}
